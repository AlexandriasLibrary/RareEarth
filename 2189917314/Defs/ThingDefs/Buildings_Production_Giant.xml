<?xml version="1.0" encoding="utf-8" ?>
<Defs>  

  <ThingDef ParentName="BenchBase">
    <defName>GiantRareEarthSmelter</defName>
    <label>Giant rare earth smelter</label>
    <thingClass>Building_WorkTable_HeatPush</thingClass>
    <description>Extracts massive amounts of rare earth minerals from slag chunks and other mixed metal items and ore. Consumes a f*%#ton of power but yields a very high amount of minerals. Can also be used to induce radiation.</description>	
    <graphicData>
      <texPath>Things/Building/GRES/GRES</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,2)</drawSize>
      <shadowData>
        <volume>(1.95,0.5,1.3)</volume>
      </shadowData>
      <damageData>
        <rect>(0.3,0.1,2.4,1.8)</rect>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <constructEffect>ConstructMetal</constructEffect>
    <costList>
      <Steel>500</Steel>
      <ComponentIndustrial>25</ComponentIndustrial>
	  <Uranium>20</Uranium>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>1</fillPercent>
    <passability>Impassable</passability>
    <useHitPoints>True</useHitPoints>
    <statBases>
      <WorkToBuild>7500</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>1.0</Flammability>
    </statBases>
    <size>(3,2)</size>
    <designationCategory>Production</designationCategory>
    <pathCost>70</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <interactionCellIcon>DiningChair</interactionCellIcon>
    <surfaceType>Item</surfaceType>
        <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <recipes>
      <li>ExtractMetalFromSlag</li>
	  <li>ExtractATonofMineralsFromDebris</li>
	  <li>InduceRadiation</li>
      <li>SmeltWeapon</li>
      <li>DestroyWeapon</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>4500</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Glower">
        <glowRadius>14</glowRadius>
        <glowColor>(217,112,33,0)</glowColor>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>20</heatPerSecond>
      </li>
      <li Class="CompProperties_Breakdownable"/>
    </comps>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <heatPerTickWhileWorking>0.32</heatPerTickWhileWorking>
            <buildingTags>
		<li>Production</li>
      </buildingTags>
      </building>
    <designationHotKey>Misc10</designationHotKey>
    <researchPrerequisites>
	  <li>IndustrialRareEarthSmelting</li>
    </researchPrerequisites>
    <rotatable>true</rotatable>
  </ThingDef>
  
</Defs>