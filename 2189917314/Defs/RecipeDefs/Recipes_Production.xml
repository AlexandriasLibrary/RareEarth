<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<RecipeDef>
    <defName>ExtractSomeMineralsFromDebris</defName>
    <label>smelt minerals from debris</label>
    <description>Use heat and strong electromagnets to separate as many useful rare earth minerals from useless rock debris as possible.</description>
    <jobString>Smelting minerals from rock debris.</jobString>
    <workAmount>350</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ChunkLimestone</li>
			<li>ChunkGranite</li>
			<li>ChunkSandstone</li>
			<li>ChunkSlate</li>
			<li>ChunkMarble</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <products>
      <Steel>12</Steel>
	<Gold>1</Gold>
	<Silver>2</Silver>
	<Plasteel>3</Plasteel>
    </products>
    <fixedIngredientFilter>
      <thingDefs>
        <li>ChunkLimestone</li>
		<li>ChunkGranite</li>
		<li>ChunkSandstone</li>
		<li>ChunkSlate</li>
		<li>ChunkMarble</li>
      </thingDefs>
    </fixedIngredientFilter>	
	<skillRequirements>
		<Crafting>5</Crafting>
	</skillRequirements>
    <workSkill>Crafting</workSkill>
  </RecipeDef>

